# ============================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Option 1: Use DATABASE_URL (Recommended for Production)
# This is automatically provided by Render, Railway, Heroku, etc.
# Uncomment and use this for production-like local testing:
# DATABASE_URL=postgresql://user:password@localhost:5432/todoapp

# Option 2: Use Individual Database Variables (Local Development)
# The app will automatically construct DATABASE_URL from these if DATABASE_URL is not set
DB_HOST=localhost
DB_NAME=todoapp
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_PORT=5432

# ============================================
# FLASK CONFIGURATION
# ============================================
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# ============================================
# DEPLOYMENT NOTES
# ============================================
# For Render/Railway/Heroku deployments:
# - DATABASE_URL is automatically set when you connect a PostgreSQL database
# - Set FLASK_ENV=production and FLASK_DEBUG=False in your service settings
# - PORT is automatically provided by the platform
# - You do NOT need to manually set DB_HOST, DB_NAME, etc. on the platform

